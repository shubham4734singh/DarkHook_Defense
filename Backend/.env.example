# DarkHook Defense - Environment Configuration Example
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit your .env file with real credentials!

# MongoDB Atlas Configuration
# Get this from: MongoDB Atlas -> Cluster -> Connect -> Connect your application
# Replace <username>, <password>, and <cluster> with your actual values
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# Database Name
DATABASE_NAME=Phishing

# JWT Secret Key (generate a secure random key for production)
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# JWT Algorithm
JWT_ALGORITHM=HS256

# JWT Access Token Expiration (minutes)
# 1440 minutes = 1 day
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Auth rate limiting / brute-force protection
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_OTP_REQUEST_MAX_ATTEMPTS=5
AUTH_OTP_VERIFY_MAX_ATTEMPTS=10
MAX_EMAIL_UPLOAD_BYTES=5242880
MAX_DOCUMENT_UPLOAD_BYTES=10485760

# Frontend URL (for CORS)
# For local development: http://localhost:5173
# For production on Vercel: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Comma-separated list of additional allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-custom-domain.com

# Additional Trusted Domains whitelist for Link Analyzer
ADDITIONAL_TRUSTED_DOMAINS=youruniversity.ac.in,trusted-partner.com

# VirusTotal Threat Intelligence API & Delays (in seconds)
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
# VIRUSTOTAL_REQUEST_INTERVAL_SECONDS=16
# VIRUSTOTAL_POLL_INTERVAL_SECONDS=15
# VIRUSTOTAL_RATE_LIMIT_BACKOFF_SECONDS=60

# Persistence & Cloud DNS Resolvers
# SQLITE_DB_PATH=darkhook_defense.db
# DNS_NAMESERVERS=8.8.8.8,1.1.1.1,8.8.4.4

# Local backend port
# Default is 8000. If you already have something running on 8000 (e.g., Splunk),
# set this to 8001 (and update Frontend VITE_API_BASE_URL accordingly).
PORT=8000

# Backend URL
# Production (Render): https://darkhook-defense.onrender.com
# Local: http://localhost:8000 (or http://localhost:8001 if PORT=8001)
BACKEND_URL=http://localhost:8000

# URL Analysis ML Service
# If the external Hugging Face Space is unstable, set this to false and the
# URL module will use the built-in heuristic + dynamic engine only.
URL_ANALYSIS_ML_ENABLED=true
URL_ANALYSIS_ML_API_URL=https://cybersky4734-phising.hf.space/scan
URL_ANALYSIS_ML_TIMEOUT_SECONDS=20
URL_ANALYSIS_SCREENSHOT_SERVICE_URL=https://your-screenshot-service.onrender.com/capture
URL_ANALYSIS_SCREENSHOT_SERVICE_TIMEOUT_SECONDS=25
URL_ANALYSIS_SCREENSHOT_SERVICE_API_KEY=your_shared_screenshot_service_key

URL_ANALYSIS_TLS_LOOKUP_ENABLED=false
URL_ANALYSIS_DYNAMIC_TIMEOUT_SECONDS=6
# -------------------------
# Email OTP Configuration (Brevo HTTPS REST API)
# -------------------------
# Get your API key from: https://app.brevo.com/settings/keys/api
# Bypasses SMTP port blocking on free cloud hosting (e.g. Render)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_brevo_sender@domain.com
BREVO_SENDER_NAME=DarkHook Defense

# OTP / verification behavior
REQUIRE_EMAIL_VERIFICATION=true
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Development-only helper: when enabled, OTP is not emailed (printed to logs)
# OTP_EMAIL_SENDING_DISABLED=true

# ====================
# IMPORTANT: To fix MongoDB Atlas connection errors:
# ====================
#
# 1. Go to https://cloud.mongodb.com/v2/
# 2. Select your project
# 3. Click "Network Access" in the left sidebar
# 4. Click "Add IP Address"
# 5. Add your current IP address (find it at https://whatismyip.com)
#    OR use "0.0.0.0/0" for development (not recommended for production)
# 6. Wait 2-5 minutes for changes to take effect
#
# If you see error: "TLSV1_ALERT_INTERNAL_ERROR: SSL alert number 80"
# This typically means your IP is not whitelisted in MongoDB Atlas
